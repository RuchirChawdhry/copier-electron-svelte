import { app, BrowserWindow, dialog, ipcMain, Menu, shell } from 'electron';
import { join } from 'node:path';
import { is } from '@electron-toolkit/utils';
import { JUMP_LIST_COMMANDS, isCommandId, type CommandId } from '../shared/commands';
import { buildJumpList } from './jump-list';
import { getSettings, updateSettings } from './settings';
import type { AppSettings } from '../shared/settings';
import icon from '../../resources/icon.png?asset';

let mainWindow: BrowserWindow | null = null;
const pendingCommands: CommandId[] = [];
const pendingFolders: string[] = [];

function executeCommand(id: CommandId): void {
  if (mainWindow?.webContents.isLoading()) {
    pendingCommands.push(id);
    return;
  }
  mainWindow?.webContents.send('command:execute', id);
}

function openFromArguments(args: string[]): void {
  const id = args.find((argument) => argument.startsWith('--command='))?.slice('--command='.length);
  if (id && isCommandId(id) && JUMP_LIST_COMMANDS.some((allowed) => allowed === id))
    executeCommand(id);

  const encoded = args
    .find((argument) => argument.startsWith('--folder64='))
    ?.slice('--folder64='.length);
  if (encoded) openWorkspace(Buffer.from(encoded, 'base64url').toString('utf8'));
}

function openWorkspace(path: string): void {
  if (mainWindow?.webContents.isLoading()) {
    pendingFolders.push(path);
    return;
  }
  mainWindow?.webContents.send('workspace:open', path);
}

function createWindow(): void {
  const window = new BrowserWindow({
    width: 1180,
    height: 760,
    minWidth: 760,
    minHeight: 480,
    show: false,
    backgroundColor: '#101010',
    titleBarStyle: 'hidden',
    ...(process.platform !== 'darwin'
      ? { titleBarOverlay: { color: '#171717', symbolColor: '#ededed', height: 42 } }
      : {}),
    ...(process.platform === 'linux' ? { icon } : {}),
    webPreferences: {
      preload: join(__dirname, '../preload/index.js'),
      contextIsolation: true,
      nodeIntegration: false,
      sandbox: true,
      devTools: !app.isPackaged,
    },
  });
  mainWindow = window;
  window.on('ready-to-show', () => window.show());
  window.on('closed', () => {
    if (mainWindow === window) mainWindow = null;
  });
  window.webContents.on('did-finish-load', () => {
    for (const command of pendingCommands.splice(0)) executeCommand(command);
    for (const path of pendingFolders.splice(0)) openWorkspace(path);
  });
  window.webContents.setWindowOpenHandler(({ url }) => {
    if (url.startsWith('https://')) void shell.openExternal(url);
    return { action: 'deny' };
  });

  if (is.dev && process.env.ELECTRON_RENDERER_URL) {
    void window.loadURL(process.env.ELECTRON_RENDERER_URL);
  } else {
    void window.loadFile(join(__dirname, '../renderer/index.html'));
  }
}

async function installJumpList(): Promise<void> {
  if (process.platform !== 'win32' || !app.isPackaged) return;

  const windowsRoot = process.env.SystemRoot ?? 'C:\\Windows';
  const result = app.setJumpList(
    buildJumpList({
      executable: process.execPath,
      shellIcons: join(windowsRoot, 'System32', 'shell32.dll'),
      explorer: join(windowsRoot, 'explorer.exe'),
      settings: await getSettings(),
      removedItems: app.getJumpListSettings().removedItems,
    }),
  );
  if (result !== 'ok') console.warn('Jump List registration:', result);
}

const hasLock = app.requestSingleInstanceLock();
if (!hasLock) app.quit();

app.on('second-instance', (_event, argv) => {
  mainWindow?.show();
  mainWindow?.focus();
  openFromArguments(argv);
});

if (hasLock) {
  app.whenReady().then(() => {
    // prettier-ignore
    if (process.platform === 'win32') app.setAppUserModelId({{ app_id | tojson }});
    void installJumpList();

    ipcMain.handle('settings:get', () => getSettings());
    ipcMain.handle('settings:update', async (_event, change: Partial<AppSettings>) => {
      const saved = await updateSettings(change);
      if (change.pinnedTabs || change.recentFolders) void installJumpList();
      return saved;
    });
    ipcMain.on('window:theme', (_event, theme: string) => {
      if (process.platform === 'darwin' || !mainWindow) return;
      const colors: Record<string, { color: string; symbolColor: string }> = {
        dark: { color: '#171717', symbolColor: '#ededed' },
        light: { color: '#eeeeee', symbolColor: '#202020' },
        solarized: { color: '#073642', symbolColor: '#eee8d5' },
      };
      if (colors[theme]) mainWindow.setTitleBarOverlay({ ...colors[theme], height: 42 });
    });
    ipcMain.handle('folder:select', async () => {
      const result = await dialog.showOpenDialog(mainWindow!, { properties: ['openDirectory'] });
      if (result.canceled) return null;
      const path = result.filePaths[0];
      const { recentFolders } = await getSettings();
      await updateSettings({
        recentFolders: [path, ...recentFolders.filter((item) => item !== path)].slice(0, 6),
      });
      void installJumpList();
      return path;
    });

    Menu.setApplicationMenu(
      Menu.buildFromTemplate([
        { role: 'appMenu' },
        { role: 'fileMenu' },
        { role: 'editMenu' },
        {
          label: 'View',
          submenu: [
            { role: 'resetZoom' },
            { role: 'zoomIn' },
            { role: 'zoomOut' },
            { type: 'separator' },
            { role: 'togglefullscreen' },
            ...(!app.isPackaged ? [{ role: 'toggleDevTools' as const }] : []),
          ],
        },
        { role: 'windowMenu' },
      ]),
    );

    createWindow();
    openFromArguments(process.argv);
    app.on('activate', () => {
      if (BrowserWindow.getAllWindows().length === 0) createWindow();
    });
  });
}

app.on('window-all-closed', () => {
  if (process.platform !== 'darwin') app.quit();
});
